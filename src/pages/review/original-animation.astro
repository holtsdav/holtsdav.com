---
import DarkWordmarkReference from '../../components/DarkWordmarkReference.astro';
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex, nofollow"/><title>Original dark animation — local comparison</title></head><body><main><DarkWordmarkReference/></main></body></html>
<style is:global>body{margin:0;background:#090d14;color:#e4ebff;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif}main{padding-top:107px}particle-wordmark.particle-wordmark{width:min(850px,85vw)!important;height:230px!important}particle-wordmark h1{font-size:clamp(54px,11vw,145px);font-weight:800;letter-spacing:-.055em;opacity:1}particle-wordmark[data-particle-ready=true] h1{opacity:0}@media(max-width:760px){main{padding-top:74px}particle-wordmark.particle-wordmark{width:100%!important;height:230px!important}particle-wordmark h1{font-size:18vw}}</style>
