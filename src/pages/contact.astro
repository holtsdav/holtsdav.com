---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact | holtsdav" description="Get in touch with David Holtschke by email or send a message." canonical="https://holtsdav.com/contact/">
	<section class="contact-page shell" aria-labelledby="contact-title">
		<header class="contact-heading">
			<h1 id="contact-title">Contact</h1>
			<p>Have a question or something in mind? Get in touch.</p>
		</header>
		<div class="contact-options">
			<section class="contact-email" aria-labelledby="email-title">
				<h2 id="email-title">Send an email</h2>
				<p>Use your own email app.</p>
				<a href="mailto:contact@holtsdav.com">contact@holtsdav.com<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></a>
			</section>
			<section aria-labelledby="form-title">
				<h2 id="form-title">Leave a message</h2>
				<form id="contact-form" action="/api/contact" method="post" tabindex="-1">
					<div class="contact-field-row">
						<div class="contact-field">
							<label for="contact-name">Name</label>
							<input id="contact-name" name="name" autocomplete="name" maxlength="80" required aria-describedby="name-error" />
							<span class="field-error" id="name-error"></span>
						</div>
						<div class="contact-field">
							<label for="contact-email">Email</label>
							<input id="contact-email" name="email" type="email" autocomplete="email" maxlength="254" required aria-describedby="email-error" />
							<span class="field-error" id="email-error"></span>
						</div>
					</div>
					<div class="contact-field">
						<label for="contact-message">Message</label>
						<textarea id="contact-message" name="message" rows="6" maxlength="5000" required aria-describedby="message-hint message-error"></textarea>
						<span class="field-hint" id="message-hint">Up to 5,000 characters.</span>
						<span class="field-error" id="message-error"></span>
					</div>
					<div class="contact-trap" aria-hidden="true" inert>
						<label for="contact-website">Leave this field empty</label>
						<input id="contact-website" name="website" tabindex="-1" autocomplete="off" />
					</div>
					<p class="contact-privacy">Your details are used to reply to your message. <a href="/privacy/">Privacy policy</a></p>
					<div id="contact-verification"></div>
					<p id="contact-status" class="contact-status" role="status" aria-live="polite" tabindex="-1"></p>
					<button class="contact-submit" type="submit" disabled><span>Send message</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></button>
					<noscript><p>Please enable JavaScript to use the form, or <a href="mailto:contact@holtsdav.com">send an email directly</a>.</p></noscript>
				</form>
			</section>
		</div>
	</section>
</BaseLayout>

<script src="../scripts/contact-form.ts"></script>

<style>
	.contact-page { max-width: 1000px; padding-block: clamp(48px, 7vw, 92px) 88px; }
	.contact-heading { margin-bottom: 52px; }
	h1 { margin: 0 0 16px; font-size: clamp(42px, 5vw, 64px); font-weight: 740; line-height: 1.05; letter-spacing: -0.04em; }
	h2 { margin: 0 0 12px; font-size: 24px; line-height: 1.25; letter-spacing: -0.025em; }
	p { margin: 0; color: var(--color-secondary); }
	.contact-options { display: grid; grid-template-columns: 0.85fr 1.5fr; gap: clamp(40px, 6vw, 88px); }
	.contact-email a { display: inline-flex; align-items: center; gap: 10px; margin-top: 20px; color: var(--color-accent); font-size: 19px; text-decoration: underline; text-underline-offset: 5px; }
	svg { flex: 0 0 auto; width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
	form { display: grid; gap: 20px; margin-top: 24px; scroll-margin-top: 112px; }
	.contact-field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
	.contact-field { display: grid; gap: 8px; min-width: 0; }
	label { font-size: 15px; font-weight: 700; }
	input, textarea { width: 100%; min-width: 0; padding: 12px 14px; border: 1px solid #555c6f; border-radius: 10px; background: var(--color-elevated); color: var(--color-primary); font: inherit; font-size: 16px; line-height: 1.5; caret-color: var(--color-accent); }
	textarea { resize: vertical; min-height: 150px; }
	input:focus-visible, textarea:focus-visible, button:focus-visible { outline: 3px solid var(--color-accent); outline-offset: 3px; }
	input[aria-invalid="true"], textarea[aria-invalid="true"] { border-color: #ffb4bd; }
	.field-hint, .field-error, .contact-privacy, .contact-status { font-size: 14px; line-height: 1.55; }
	.field-hint { color: var(--color-secondary); }
	.field-error, .contact-status[data-state="error"] { color: #ffb4bd; }
	.field-error:empty, .contact-status:empty { display: none; }
	.contact-status[data-state="success"] { color: #b7e7cb; }
	.contact-privacy a, noscript a { color: var(--color-accent); text-decoration: underline; text-underline-offset: 3px; }
	.contact-submit { display: inline-flex; align-items: center; justify-content: center; gap: 12px; justify-self: start; min-height: 48px; padding: 12px 20px; border: 0; border-radius: 10px; background: var(--color-accent); color: var(--color-page); font: inherit; font-size: 16px; font-weight: 700; cursor: pointer; transition: background 160ms ease; }
	.contact-submit:hover:enabled { background: #b5c0ff; }
	.contact-submit:disabled { opacity: 0.55; cursor: not-allowed; }
	.contact-trap { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
	@media (max-width: 760px) {
		.contact-heading { margin-bottom: 36px; }
		.contact-options { grid-template-columns: 1fr; gap: 40px; }
		.contact-email { padding-bottom: 32px; border-bottom: 1px solid #2b2f3b; }
	}
	@media (max-width: 460px) {
		.contact-field-row { grid-template-columns: 1fr; gap: 20px; }
		.contact-submit { width: 100%; }
	}
</style>
