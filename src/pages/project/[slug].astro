---
export function getStaticPaths() {
  return [
    { params: { slug: 'mute-on-location' }, props: { destination: '/apps/mute-on-location/', status: 301 } },
    { params: { slug: 'rogue-color' }, props: { destination: '/apps/rogue-color/', status: 301 } },
    { params: { slug: 'RoomPlanner' }, props: { destination: '/apps/room-planner/', status: 301 } },
    { params: { slug: 'notilog' }, props: { destination: '/#projects', status: 302 } },
  ];
}
return Astro.redirect(Astro.props.destination, Astro.props.status);
