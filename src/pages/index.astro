---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import ParticleWordmark from '../components/ParticleWordmark.astro';
import AppIconLinks from '../components/AppIconLinks.astro';
import AppleStoreButton from '../components/AppleStoreButton.astro';
import ServiceButton from '../components/ServiceButton.astro';
---

	<BaseLayout
	title="holtsdav | Apps und Software von David Holtschke"
	description="Apps und Spiele von David Holtschke: Glassdays Countdown, Rogue Color und Mute On Location."
	canonical="https://holtsdav.com/"
>
	<section class="hero shell" aria-labelledby="hero-title">
		<div class="hero-content">
			<p class="hero-eyebrow">DAVID HOLTSCHKE · SOFTWAREENTWICKLER AUS MÜNCHEN</p>
			<div class="hero-constellation">
				<ParticleWordmark />
				<AppIconLinks />
			</div>
			<p class="hero-subheading">Eigene Apps und Softwareprojekte.</p>
			<p class="hero-description">
				Ich bin David Holtschke, Softwareentwickler aus München. Hier findest du
				meine veröffentlichten Apps, aktuelle Projekte und den dazugehörigen
				Quellcode.
			</p>
			<div class="hero-buttons">
				<a class="button button-primary" href="#projects">Projekte ansehen</a>
				<a class="button button-secondary" href="mailto:contact@holtsdav.com">Kontakt aufnehmen</a>
			</div>
			<SocialLinks class="hero-socials" />
		</div>
	</section>

	<section class="section shell" id="projects" aria-labelledby="projects-title">
		<header class="section-header">
			<h2 id="projects-title">Projekte</h2>
			<p>Apps für Apple-Plattformen und ein Spielprojekt mit Godot.</p>
		</header>

		<div class="projects-list">
			<article class="project-card project-glassdays">
				<a class="project-media" href="/apps/glassdays-countdown/" aria-label="Mehr über Glassdays Countdown">
					<Image
						src="/Glassdays.gif"
						alt="Glassdays Countdown zeigt persönliche Countdowns und Sammlungen"
						width={800}
						height={600}
						loading="lazy"
					/>
				</a>
				<div class="project-content">
					<p class="status-badge">Verfügbar im App Store</p>
					<h3>Glassdays Countdown</h3>
					<p>Glassdays macht aus wichtigen Terminen persönliche Countdowns. Gestalte sie mit Fotos und Emojis, ordne sie in Sammlungen und behalte sie mit Widgets und Erinnerungen im Blick.</p>
					<ul class="tech-list" aria-label="Technologien und Funktionen">
						<li>iPhone &amp; iPad</li>
						<li>Widgets</li>
						<li>iCloud optional</li>
					</ul>
					<div class="project-actions">
						<a class="button button-primary" href="/apps/glassdays-countdown/">Details</a>
						<AppleStoreButton
							href="https://apps.apple.com/de/app/glassdays-countdown/id6785538729"
							label="Laden im App Store"
						/>
					</div>
				</div>
			</article>

			<article class="project-card project-reversed project-rogue">
				<a class="project-media" href="/apps/rogue-color/" aria-label="Mehr über Rogue Color">
					<Image
						src="/rogue-color-gameplay.png"
						alt="Spielszene aus Rogue Color mit schwarz-weißen Gegnern und Verbesserungen"
						width={639}
						height={359}
						loading="lazy"
					/>
				</a>
				<div class="project-content">
					<p class="status-badge">Kostenlos spielbar</p>
					<h3>Rogue Color</h3>
					<p>Ein Survival-Actionspiel in Schwarz und Weiß. Passe deine Farbe an die Gegner an, sammle Verbesserungen und versuche, deinen eigenen Rekord zu schlagen.</p>
					<ul class="tech-list" aria-label="Technologien und Funktionen">
						<li>Godot</li>
						<li>2D Pixel Art</li>
						<li>Game Jam</li>
						<li>Desktop</li>
					</ul>
					<div class="project-actions">
						<a class="button button-primary" href="/apps/rogue-color/">Details</a>
						<ServiceButton
							service="itch"
							href="https://holtsdav.itch.io/rouge-color"
							label="Auf itch.io öffnen"
							variant="filled"
						/>
						<ServiceButton
							service="github"
							href="https://github.com/holtsdav/RogueColor"
							label="GitHub"
							variant="outline"
						/>
					</div>
				</div>
			</article>

			<article class="project-card project-mute">
				<a class="project-media project-media-mute" href="/apps/mute-on-location/" aria-label="Mehr über Mute On Location">
					<Image
						src="/MuteOnLocation.png"
						alt="Mute On Location mit App-Icon und macOS-Menüleistenfenster"
						width={2880}
						height={1800}
						loading="lazy"
					/>
				</a>
				<div class="project-content">
					<p class="status-badge">In Entwicklung</p>
					<h3>Mute On Location</h3>
					<p>Eine macOS-Menüleisten-App, die die aktuelle Audioausgabe automatisch stummschaltet, sobald du einen gespeicherten Ort erreichst.</p>
					<ul class="tech-list" aria-label="Technologien und Funktionen">
						<li>macOS</li>
						<li>SwiftUI</li>
						<li>Standort</li>
						<li>Automation</li>
					</ul>
					<div class="project-actions">
						<a class="button button-primary" href="/apps/mute-on-location/">Details</a>
					</div>
				</div>
			</article>
		</div>
	</section>

	<section class="section about-section" id="about" aria-labelledby="about-title">
		<div class="shell">
			<header class="section-header">
				<h2 id="about-title">Hinter holtsdav</h2>
			</header>

			<div class="about-layout">
				<div class="about-copy">
					<p>Ich bin David Holtschke, Softwareentwickler aus München und Auszubildender zum Fachinformatiker für Anwendungsentwicklung. Neben meiner Ausbildung arbeite ich an eigenen Apps und Spielen.</p>
					<p>Mein Schwerpunkt liegt auf SwiftUI und nativen Apps für Apple-Plattformen. Dabei beschäftige ich mich mit Produktidee, Gestaltung, Entwicklung und Veröffentlichung.</p>
				</div>
				<div class="focus-areas">
					<article>
						<h3>iOS &amp; SwiftUI</h3>
						<p>Native Apps für Apple-Plattformen.</p>
					</article>
					<article>
						<h3>macOS &amp; Automatisierung</h3>
						<p>Werkzeuge, die wiederkehrende Aufgaben übernehmen.</p>
					</article>
					<article>
						<h3>Godot &amp; Spiele</h3>
						<p>Kleine Spielprojekte und Experimente.</p>
					</article>
				</div>
			</div>
		</div>
	</section>

	<section class="section shell" id="contact" aria-labelledby="contact-title">
		<div class="contact-panel">
			<div class="contact-copy">
				<h2 id="contact-title">Kontakt</h2>
				<p>Du hast eine Frage zu einem Projekt oder möchtest Feedback geben? Schreib mir per E-Mail oder finde mich auf GitHub, LinkedIn und X.</p>
			</div>
			<div class="contact-actions">
				<a class="button contact-button" href="mailto:contact@holtsdav.com">contact@holtsdav.com</a>
				<SocialLinks class="contact-socials" />
			</div>
		</div>
	</section>
</BaseLayout>
