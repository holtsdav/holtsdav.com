---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppIconLinks from '../components/AppIconLinks.astro';
import ParticleWordmark from '../components/ParticleWordmark.astro';
import glassdaysPreview from '../../Assets/Glassdays.gif';
import muteOnLocationPreview from '../../Assets/MuteOnLocation-preview.png';
import rogueColorPreview from '../../Assets/rogue-color-gameplay.png';
import roomPlannerPreview from '../../Assets/RoomPlaner.png';
import holtsdavLogo from '../../Assets/holtsdav-logo.png';

const projects = [
	{
		name: 'Glassdays Countdown',
		description: 'A personal countdown app for special moments, reminders, and everything you are looking forward to.',
		href: '/project/glassdays/',
		storeHref: 'https://apps.apple.com/de/app/glassdays-countdown/id6785538729',
		itchHref: null,
		githubHref: 'https://github.com/holtsdav/Glassdays',
		githubLabel: 'Open Glassdays on GitHub',
		image: glassdaysPreview.src,
		imageAlt: 'Placeholder preview for Glassdays Countdown',
		imageClass: 'project-gallery-image-cover project-gallery-image-glassdays',
		category: 'iPhone & iPad',
		categoryIcon: 'phone',
			tags: [
			{ label: 'Ai assisted', icon: 'ai' },
			{ label: 'Swift', icon: 'swift', logo: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/swift/swift-original.svg' },
			{ label: 'Xcode', icon: 'xcode', logo: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/xcode/xcode-original.svg' },
			{ label: 'Monetized', icon: 'monetized' },
		],
	},
	{
		name: 'Mute On Location',
		description: 'A macOS app that automatically mutes your audio output when you arrive at a saved location.',
		href: '/project/mute-on-location/',
		storeHref: 'https://apps.apple.com/de/app/mute-on-location/id6790398791?l=en-GB&mt=12',
		itchHref: null,
		githubHref: 'https://github.com/holtsdav/MuteOnLocation',
		githubLabel: 'Open Mute On Location on GitHub',
		image: muteOnLocationPreview.src,
		imageAlt: 'Placeholder preview for Mute On Location',
		imageClass: 'project-gallery-image-cover',
		category: 'macOS',
		categoryIcon: 'laptop',
			tags: [
			{ label: 'Ai assisted', icon: 'ai' },
			{ label: 'Swift', icon: 'swift', logo: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/swift/swift-original.svg' },
			{ label: 'Xcode', icon: 'xcode', logo: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/xcode/xcode-original.svg' },
			{ label: 'Monetized', icon: 'monetized' },
		],
	},
	{
		name: 'Rogue Color',
		description: 'A fast-paced black-and-white game about reactions, color, and chasing your next high score.',
		href: '/project/rogue-color/',
		storeHref: null,
		itchHref: 'https://holtsdav.itch.io/rouge-color',
		githubHref: 'https://github.com/holtsdav/RogueColor',
		githubLabel: 'Open Rogue Color on GitHub',
		image: rogueColorPreview.src,
		imageAlt: 'Placeholder preview for Rogue Color',
		imageClass: 'project-gallery-image-cover project-gallery-image-pixel',
		category: 'Desktop Game',
		categoryIcon: 'desktop',
		tags: [
			{ label: 'Godot', icon: 'godot', logo: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/godot/godot-original.svg' },
			{ label: 'No Ai used', icon: 'no-ai' },
			{ label: 'Not Monetized', icon: 'not-monetized' },
		],
	},
	{
		name: 'Room Planner',
		description: 'Explore Room Planner on holtsdav.com.',
		href: '/project/RoomPlanner/',
		websiteHref: 'https://holtsdav.com/RoomPlanner',
		storeHref: null,
		itchHref: null,
		githubHref: 'https://github.com/holtsdav/RoomPlanner',
		githubLabel: 'Open Room Planner on GitHub',
		image: roomPlannerPreview.src,
		imageAlt: 'Room Planner floor plan showing a furnished room layout',
		imageClass: 'project-gallery-image-cover',
		category: 'Web project',
		categoryIcon: 'web',
		tags: [
			{ label: 'Ai assisted', icon: 'ai' },
			{ label: 'Astro', icon: 'astro', logo: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/astro/astro-original.svg' },
			{ label: 'Not Monetized', icon: 'not-monetized' },
		],
		hideStorePlaceholder: true,
	},
	{
		name: 'NotiLog',
		description: 'A new software project in the works. More details and real previews are coming later.',
		href: '/project/notilog/',
		storeHref: null,
		itchHref: null,
		githubHref: 'https://github.com/holtsdav/NotiLog',
		githubLabel: 'Open NotiLog on GitHub',
		image: holtsdavLogo.src,
		imageAlt: 'Placeholder artwork for NotiLog',
		imageClass: 'project-gallery-image-placeholder',
		notilogLogo: true,
		category: 'iPhone & iPad',
		categoryIcon: 'phone',
			tags: [
			{ label: 'Ai assisted', icon: 'ai' },
			{ label: 'Swift', icon: 'swift', logo: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/swift/swift-original.svg' },
			{ label: 'Xcode', icon: 'xcode', logo: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/xcode/xcode-original.svg' },
			{ label: 'Monetized', icon: 'monetized' },
		],
	},
];
---

<script is:inline>
	if (window.location.hash === '#contact') {
		window.location.replace('/contact/#contact-form');
	}
</script>

<BaseLayout
	title="holtsdav | David Holtschke"
	description="David Holtschke – software developer based in Munich, Germany."
	canonical="https://holtsdav.com/"
>
	<section class="hero shell" aria-labelledby="hero-title">
		<div class="hero-constellation">
			<AppIconLinks />
			<ParticleWordmark />
			<a class="hero-projects-button" href="#projects">
				My Projects
				<svg viewBox="0 0 20 20" aria-hidden="true">
					<path d="m4 7 6 6 6-6" />
				</svg>
			</a>
		</div>
	</section>

	<section class="home-about shell" id="about" aria-labelledby="about-title">
		<div class="home-about-card">
			<div class="home-about-image" aria-hidden="true">
				<img src={holtsdavLogo.src} alt="" width="500" height="500" loading="lazy" />
				<span>Placeholder image</span>
			</div>
			<div class="home-about-copy">
				<p class="home-section-label">About me</p>
				<h2 id="about-title">Hi, I’m David.</h2>
				<p>
					This is where a short introduction about me, my work, and the things I enjoy building will go.
					The copy and image are placeholders for now and can easily be replaced later.
				</p>
				<div class="home-about-actions">
					<a class="home-about-action" href="mailto:contact@holtsdav.com">
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<path d="M3 5.5h18v13H3z" />
							<path d="m3.5 6 8.5 7 8.5-7" />
						</svg>
						Email
					</a>
					<a
						class="home-about-action"
						href="https://www.linkedin.com/in/david-holtschke"
						target="_blank"
						rel="noreferrer"
					>
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<path fill="currentColor" d="M20.5 3H3.5A.5.5 0 0 0 3 3.5v17a.5.5 0 0 0 .5.5h17a.5.5 0 0 0 .5-.5v-17a.5.5 0 0 0-.5-.5ZM8.3 18.3H5.6V9.7h2.7v8.6ZM7 8.5a1.6 1.6 0 1 1 0-3.1 1.6 1.6 0 0 1 0 3.1Zm11.3 9.8h-2.7v-4.2c0-1 0-2.3-1.4-2.3s-1.6 1.1-1.6 2.2v4.3H9.9V9.7h2.6v1.2c.4-.7 1.3-1.5 2.6-1.5 2.8 0 3.3 1.8 3.3 4.2v4.7Z" />
						</svg>
						LinkedIn
					</a>
				</div>
			</div>
		</div>
	</section>

	<section class="home-projects shell" id="projects" aria-labelledby="projects-title">
		<header class="home-section-header">
			<div>
				<p class="home-section-label">Selected work</p>
				<h2 id="projects-title">My Projects</h2>
			</div>
			<p>A growing collection of my apps, games, and experiments.</p>
		</header>

		<div class="project-gallery">
			{projects.map((project) => (
				<article class="project-gallery-card">
					<div class="project-gallery-preview">
						{project.notilogLogo ? (
							<div class="project-gallery-notilog-logo" aria-label="NotiLog logo" role="img">
								<svg viewBox="0 0 24 24" aria-hidden="true">
									<path fill="currentColor" d="M18 3a4 4 0 0 1 4 4v8a4 4 0 0 1-4 4h-4.724l-4.762 2.857a1 1 0 0 1-1.508-.743L7 21v-2H6a4 4 0 0 1-3.995-3.8L2 15V7a4 4 0 0 1 4-4zm-4 9H8a1 1 0 0 0 0 2h6a1 1 0 0 0 0-2m2-4H8a1 1 0 1 0 0 2h8a1 1 0 0 0 0-2" />
								</svg>
							</div>
						) : (
							<img
								class={project.imageClass}
								src={project.image}
								alt={project.imageAlt}
								width="800"
								height="520"
								loading="lazy"
								decoding="async"
							/>
						)}
						<div class="project-gallery-tags">
							<span class="project-gallery-category">
								{project.categoryIcon === 'phone' && <svg class="project-gallery-device-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="2" width="12" height="20" rx="2" /><path d="M10 18h4" /></svg>}
								{project.categoryIcon === 'laptop' && <svg class="project-gallery-device-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="3" width="14" height="12" rx="1.5" /><path d="M2.5 18h19l-2 3h-15l-2-3Z" /></svg>}
								{project.categoryIcon === 'desktop' && <svg class="project-gallery-device-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="13" rx="1.5" /><path d="M12 16v4M8 21h8" /></svg>}
								{project.categoryIcon === 'web' && <svg class="project-gallery-device-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c2.2 2.4 3.3 5.4 3.3 9s-1.1 6.6-3.3 9c-2.2-2.4-3.3-5.4-3.3-9S9.8 5.4 12 3Z" /></svg>}
								{project.categoryIcon === 'spark' && <span class="project-gallery-tag-icon" aria-hidden="true">✦</span>}
								{project.category}
							</span>
			{project.tags.filter((tag) => !['ai', 'no-ai', 'monetized', 'not-monetized'].includes(tag.icon)).map((tag) => (
								<span class:list={['project-gallery-category', `project-gallery-tag-${tag.icon}`]}>
									{tag.icon === 'astro' ? (
										<svg class="project-gallery-tag-icon project-gallery-astro-logo" viewBox="0 0 128 128" aria-hidden="true">
											<path fill="#fff" d="M81.504 9.465c.973 1.207 1.469 2.836 2.457 6.09l21.656 71.136a90.079 90.079 0 0 0-25.89-8.765L65.629 30.28a1.833 1.833 0 0 0-3.52.004L48.18 77.902a90.104 90.104 0 0 0-26.003 8.778l21.758-71.14c.996-3.25 1.492-4.876 2.464-6.083a8.023 8.023 0 0 1 3.243-2.398c1.433-.575 3.136-.575 6.535-.575H71.72c3.402 0 5.105 0 6.543.579a7.988 7.988 0 0 1 3.242 2.402Z" />
											<path fill="#bd8cff" d="M84.094 90.074c-3.57 3.055-10.696 5.137-18.903 5.137-10.07 0-18.515-3.137-20.754-7.356-.8 2.418-.98 5.184-.98 6.954 0 0-.527 8.675 5.508 14.71a5.671 5.671 0 0 1 5.672-5.671c5.37 0 5.367 4.683 5.363 8.488v.336c0 5.773 3.527 10.719 8.543 12.805a11.62 11.62 0 0 1-1.172-5.098c0-5.508 3.23-7.555 6.988-9.938 2.989-1.894 6.309-4 8.594-8.222a15.513 15.513 0 0 0 1.875-7.41 15.55 15.55 0 0 0-.734-4.735Z" />
										</svg>
									) : tag.logo ? <img class="project-gallery-tag-icon" src={tag.logo} alt="" aria-hidden="true" /> : <span class="project-gallery-tag-icon" aria-hidden="true">{tag.icon === 'monetized' ? '$' : '✦'}</span>}
									{tag.label}
								</span>
			))}
		</div>
		{project.tags.filter((tag) => tag.icon === 'monetized' || tag.icon === 'not-monetized').map((tag) => (
			<span class:list={['project-gallery-category', 'project-gallery-monetization-tag', `project-gallery-tag-${tag.icon}`]}>
				{tag.icon === 'monetized' ? (
					<span class="project-gallery-tag-icon" aria-hidden="true">$</span>
				) : (
					<svg class="project-gallery-tag-icon project-gallery-dollar-icon" viewBox="0 0 24 24" aria-hidden="true">
						<path d="M12 3v18M15.5 7.5c-.7-.8-1.8-1.3-3.5-1.3-2.1 0-3.5 1-3.5 2.5 0 4 7 1.8 7 5.7 0 1.5-1.4 2.5-3.5 2.5-1.7 0-2.8-.5-3.5-1.3" />
						<path d="m4 4 16 16" />
					</svg>
				)}
				{tag.label}
			</span>
		))}
		{project.tags.filter((tag) => tag.icon === 'ai' || tag.icon === 'no-ai').map((tag) => (
							<span class:list={['project-gallery-category', 'project-gallery-ai-tag', `project-gallery-tag-${tag.icon}`]}>
								{tag.icon === 'ai' ? (
									<span class="project-gallery-tag-icon" aria-hidden="true">✦</span>
								) : (
									<svg class="project-gallery-tag-icon project-gallery-ai-icon" viewBox="0 0 24 24" aria-hidden="true">
										<path class="project-gallery-ai-star" d="m12 2.5 2.3 7.2 7.2 2.3-7.2 2.3-2.3 7.2-2.3-7.2-7.2-2.3 7.2-2.3 2.3-7.2Z" />
										<path d="m4 4 16 16" />
									</svg>
								)}
								{tag.label}
							</span>
						))}
					</div>

					<div class="project-gallery-body">
						<h3>{project.name}</h3>
						<p>{project.description}</p>

						<div class="project-gallery-actions">
							{project.itchHref ? (
								<a
									class="project-gallery-button project-gallery-itch"
									href={project.itchHref}
									target="_blank"
									rel="noreferrer"
									aria-label="Open Rogue Color on itch.io"
								>
									<svg viewBox="0 0 24 24" aria-hidden="true">
										<path fill="currentColor" d="M3.13 1.338C2.08 1.96.02 4.328 0 4.95v1.03c0 1.303 1.22 2.45 2.325 2.45 1.33 0 2.436-1.102 2.436-2.41 0 1.308 1.07 2.41 2.4 2.41 1.328 0 2.362-1.102 2.362-2.41 0 1.308 1.137 2.41 2.466 2.41h.024c1.33 0 2.466-1.102 2.466-2.41 0 1.308 1.034 2.41 2.363 2.41 1.33 0 2.4-1.102 2.4-2.41 0 1.308 1.106 2.41 2.435 2.41C22.78 8.43 24 7.282 24 5.98V4.95c-.02-.62-2.082-2.99-3.13-3.612-3.253-.114-5.508-.134-8.87-.133-3.362 0-7.945.053-8.87.133Zm6.376 6.477a2.74 2.74 0 0 1-.468.602c-.5.49-1.19.795-1.947.795a2.786 2.786 0 0 1-1.95-.795c-.182-.178-.32-.37-.446-.59-.127.222-.303.412-.486.59a2.788 2.788 0 0 1-1.95.795c-.092 0-.187-.025-.264-.052-.107 1.113-.152 2.176-.168 2.95v.005l-.006 1.167c.02 2.334-.23 7.564 1.03 8.85 1.952.454 5.545.662 9.15.663 3.605 0 7.198-.21 9.15-.664 1.26-1.284 1.01-6.514 1.03-8.848l-.006-1.167v-.004c-.016-.775-.06-1.838-.168-2.95-.077.026-.172.052-.263.052a2.788 2.788 0 0 1-1.95-.795c-.184-.178-.36-.368-.486-.59-.127.22-.265.412-.447.59a2.786 2.786 0 0 1-1.95.794c-.76 0-1.446-.303-1.948-.793a2.74 2.74 0 0 1-.468-.602 2.738 2.738 0 0 1-.463.602 2.787 2.787 0 0 1-1.95.794h-.16a2.787 2.787 0 0 1-1.95-.793 2.738 2.738 0 0 1-.464-.602Zm-2.004 2.59v.002c.795.002 1.5 0 2.373.953.687-.072 1.406-.108 2.125-.107.72 0 1.438.035 2.125.107.873-.953 1.578-.95 2.372-.953.376 0 1.876 0 2.92 2.934l1.123 4.028c.832 2.995-.266 3.068-1.636 3.07-2.03-.075-3.156-1.55-3.156-3.025-1.124.184-2.436.276-3.748.277-1.312 0-2.624-.093-3.748-.277 0 1.475-1.125 2.95-3.156 3.026-1.37-.004-2.468-.077-1.636-3.072l1.122-4.027c1.045-2.934 2.545-2.934 2.92-2.934Z" />
									</svg>
									itch.io
								</a>
							) : project.storeHref ? (
								<a
									class="project-gallery-button project-gallery-store"
									href={project.storeHref}
									target="_blank"
									rel="noreferrer"
								>
									<svg viewBox="0 0 24 24" aria-hidden="true">
										<path fill="currentColor" d="M16.7 12.8c0-2.5 2.1-3.7 2.2-3.8a4.8 4.8 0 0 0-3.8-2c-1.6-.2-3.1 1-3.9 1s-2-1-3.3-1c-1.7 0-3.3 1-4.2 2.5-1.8 3.1-.5 7.7 1.3 10.2.9 1.2 1.9 2.6 3.3 2.5 1.3-.1 1.8-.8 3.5-.8 1.6 0 2.1.8 3.5.8s2.4-1.2 3.2-2.5a11 11 0 0 0 1.5-3.1 4.4 4.4 0 0 1-2.3-3.8ZM14 5.3A4.4 4.4 0 0 0 15 2a4.5 4.5 0 0 0-3 1.6 4.2 4.2 0 0 0-1.1 3.2A3.7 3.7 0 0 0 14 5.3Z" />
									</svg>
									App Store
								</a>
							) : !project.hideStorePlaceholder && (
								<span
									class="project-gallery-button project-gallery-store project-gallery-button-disabled"
									aria-disabled="true"
									data-tooltip="In Development"
								>
									<svg viewBox="0 0 24 24" aria-hidden="true">
										<path fill="currentColor" d="M16.7 12.8c0-2.5 2.1-3.7 2.2-3.8a4.8 4.8 0 0 0-3.8-2c-1.6-.2-3.1 1-3.9 1s-2-1-3.3-1c-1.7 0-3.3 1-4.2 2.5-1.8 3.1-.5 7.7 1.3 10.2.9 1.2 1.9 2.6 3.3 2.5 1.3-.1 1.8-.8 3.5-.8 1.6 0 2.1.8 3.5.8s2.4-1.2 3.2-2.5a11 11 0 0 0 1.5-3.1 4.4 4.4 0 0 1-2.3-3.8ZM14 5.3A4.4 4.4 0 0 0 15 2a4.5 4.5 0 0 0-3 1.6 4.2 4.2 0 0 0-1.1 3.2A3.7 3.7 0 0 0 14 5.3Z" />
									</svg>
									App Store
								</span>
							)}

							{project.websiteHref && (
								<a
									class="project-gallery-button project-gallery-website"
									href={project.websiteHref}
									target="_blank"
									rel="noreferrer"
									aria-label={`Open ${project.name} website`}
								>
									<svg viewBox="0 0 24 24" aria-hidden="true">
										<circle cx="12" cy="12" r="9" />
										<path d="M3 12h18M12 3c2.2 2.4 3.3 5.4 3.3 9s-1.1 6.6-3.3 9c-2.2-2.4-3.3-5.4-3.3-9S9.8 5.4 12 3Z" />
									</svg>
									Open
								</a>
							)}

							{project.githubHref && (<a
								class="project-gallery-button project-gallery-github"
								href={project.githubHref}
								target="_blank"
								rel="noreferrer"
								aria-label={project.githubLabel}
							>
								<svg viewBox="0 0 24 24" aria-hidden="true">
									<path fill="currentColor" d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2.3c-3.3.7-4-1.4-4-1.4-.5-1.4-1.3-1.8-1.3-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.4 11.4 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.7 1.7.3 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3Z" />
								</svg>
							</a>)}

							<a class="project-gallery-button project-gallery-view" href={project.href} aria-label={`View ${project.name}`}>
								View
								<svg viewBox="0 0 20 20" aria-hidden="true">
									<path d="m7 4 6 6-6 6" />
								</svg>
							</a>
						</div>
					</div>
				</article>
			))}
		</div>
	</section>
</BaseLayout>
