---
import AppLanding from '../../components/AppLanding.astro';
import rogueColorIcon from '../../../Assets/app-icons/rogue-color.png';
import rogueColorPreview from '../../../Assets/rogue-color-gameplay.png';
---

<AppLanding
	name="Rogue Color"
	slug="rogue-color"
	icon={rogueColorIcon}
	status="Playable on itch.io"
	kicker="Action · Roguelite · Pixel Art"
	headline="Switch colors and survive for as long as you can."
	description="Rogue Color is a black-and-white survival action game. Match your color to your enemies, collect upgrades, and try to beat your own high score."
	accent="#b7bac2"
	features={[
		{
			number: '01',
			title: 'Switch colors',
			description: 'Press E to switch between black and white. Your color determines which enemies you can defend yourself against.',
		},
		{
			number: '02',
			title: 'Rising difficulty',
			description: 'From the third minute onward, enemy health and damage double with every additional minute.',
		},
		{
			number: '03',
			title: 'Game jam project',
			description: 'Rogue Color was my first game and was created in seven days for the Theana Game Jam theme Black & White.',
		},
	]}
	closingHeadline="My first game project."
	closingDescription="Rogue Color was built with Godot. The prototype is available for Windows, macOS, and Linux on itch.io, and the project is also on GitHub."
	primaryLabel="Open on itch.io"
	primaryHref="https://holtsdav.itch.io/rouge-color"
	secondaryLabel="GitHub"
	secondaryHref="https://github.com/holtsdav/RogueColor"
	mediaSrc={rogueColorPreview}
	mediaAlt="Rogue Color gameplay with black-and-white enemies and three selectable upgrades"
	mediaWidth={639}
	mediaHeight={359}
	mediaCaption="Rogue Color · Gameplay"
/>
