---
import AppLanding from '../../components/AppLanding.astro';
import glassdaysIcon from '../../../Assets/app-icons/glassdays.png';
import glassdaysPreview from '../../../Assets/Glassdays.gif';
---

<AppLanding
	name="Glassdays"
	slug="glassdays-countdown"
	icon={glassdaysIcon}
	status="Available on the App Store"
	kicker="Moments that matter"
	headline="Personal countdowns for the moments that matter."
	description="Glassdays turns the moments you care about into personal, visual countdowns—from a long-awaited trip to the birthday you never want to forget."
	accent="#d7d4dd"
	features={[
		{
			number: '01',
			title: 'Make it personal',
			description: 'Give every moment its own emoji and photo, pin what matters most, and organize your countdowns into beautiful collections.',
		},
		{
			number: '02',
			title: 'Keep dates in view',
			description: 'See upcoming dates in widgets, create annual repeats, and get optional reminders as each moment gets closer.',
		},
		{
			number: '03',
			title: 'No account required',
			description: 'Your countdowns stay on your device. Glassdays Pro adds features including iCloud sync, calendar integration, and custom widgets.',
		},
	]}
	closingHeadline="Your next moments at a glance."
	closingDescription="Glassdays is free for iPhone and iPad. Glassdays Pro can be unlocked with a one-time purchase."
	primaryLabel="Download on the App Store"
	primaryHref="https://apps.apple.com/de/app/glassdays-countdown/id6785538729"
	privacyHref="/privacy/glassdays/"
	mediaSrc={glassdaysPreview}
	mediaAlt="Glassdays in use, showing personal countdowns and collections on an Apple device"
	mediaWidth={800}
	mediaHeight={600}
	mediaCaption="Glassdays · App preview"
/>
