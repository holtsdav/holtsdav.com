---
import AppLanding from '../../components/AppLanding.astro';
---

<AppLanding
	name="Glassdays Countdown"
	slug="glassdays-countdown"
	icon="/app-icons/glassdays.png"
	status="Im App Store"
	kicker="Momente, die zählen"
	headline="Persönliche Countdowns für wichtige Momente."
	description="Glassdays macht aus den Momenten, die dir wichtig sind, persönliche und visuelle Countdowns – von der lange geplanten Reise bis zum Geburtstag, den du nie vergessen möchtest."
	accent="#d7d4dd"
	features={[
		{
			number: '01',
			title: 'Persönlich gestalten',
			description: 'Gib jedem Moment ein eigenes Emoji und Foto, pinne, was dir besonders wichtig ist, und organisiere deine Countdowns in schönen Sammlungen.',
		},
		{
			number: '02',
			title: 'Termine im Blick behalten',
			description: 'Sieh deine nächsten Termine in Widgets, erstelle jährliche Wiederholungen und erhalte optionale Erinnerungen, wenn ein Moment näher rückt.',
		},
		{
			number: '03',
			title: 'Ohne Benutzerkonto',
			description: 'Deine Countdowns bleiben auf deinem Gerät. Glassdays Pro ergänzt unter anderem iCloud-Synchronisierung, Kalenderintegration und eigene Widgets.',
		},
	]}
	closingHeadline="Deine nächsten Momente auf einen Blick."
	closingDescription="Glassdays ist kostenlos für iPhone und iPad erhältlich. Glassdays Pro kann mit einem einmaligen Kauf freigeschaltet werden."
	primaryLabel="Laden im App Store"
	primaryHref="https://apps.apple.com/de/app/glassdays-countdown/id6785538729"
	privacyHref="/apps/glassdays-countdown/privacy/"
	mediaSrc="/Glassdays.gif"
	mediaAlt="Glassdays Countdown in Benutzung: persönliche Countdowns und Sammlungen werden auf einem Apple-Gerät gezeigt"
	mediaWidth={800}
	mediaHeight={600}
	mediaCaption="Glassdays Countdown · App-Vorschau"
/>
