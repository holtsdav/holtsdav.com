---
import AppLanding from '../../components/AppLanding.astro';
import muteOnLocationIcon from '../../../Assets/app-icons/mute-on-location.png';
import muteOnLocationPreview from '../../../Assets/MuteOnLocation-preview.png';
---

<AppLanding
	name="Mute On Location"
	slug="mute-on-location"
	icon={muteOnLocationIcon}
	status="Available on the Mac App Store"
	kicker="macOS · Location-based muting"
	headline="Automatically mute at saved locations."
	description="Mute On Location mutes your Mac’s current audio output when you arrive at a saved location. Manage locations, radii, and automation directly from the menu bar app."
	accent="#d8c7b7"
	features={[
		{
			number: '01',
			title: 'Save locations and radii',
			description: 'Add places such as your office, school, or library and choose a suitable radius for each one.',
		},
		{
			number: '02',
			title: 'Mute automatically',
			description: 'Smart Monitoring detects when you reach a saved location and mutes the selected audio output.',
		},
		{
			number: '03',
			title: 'Data stays on your Mac',
			description: 'Saved locations and settings remain in the local app container. The app does not create a travel or location history.',
		},
	]}
	closingHeadline="Stay muted without having to remember."
	closingDescription="Mute On Location is available for Mac on the App Store. Set up your saved places and choose how the app checks for arrivals."
	primaryLabel="View on the Mac App Store"
	primaryHref="https://apps.apple.com/de/app/mute-on-location/id6790398791?l=en-GB&mt=12"
	privacyHref="/privacy/muteonlocation/"
	mediaSrc={muteOnLocationPreview}
	mediaAlt="Mute On Location showing the current location status and saved places in a macOS menu bar app"
	mediaWidth={1200}
	mediaHeight={750}
	mediaCaption="Mute On Location · macOS"
/>
