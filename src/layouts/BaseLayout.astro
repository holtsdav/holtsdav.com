---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import holtsdavLogo from '../../Assets/holtsdav-logo.png';

interface Props {
	title: string;
	description: string;
	robots?: string;
	canonical?: string | URL;
	lang?: string;
}

const { title, description, robots, canonical, lang = 'en' } = Astro.props;
const canonicalURL = canonical
	? new URL(canonical, Astro.site ?? 'https://holtsdav.com')
	: undefined;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#090a0f" />
		<meta name="color-scheme" content="dark" />
		<meta name="description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content={lang === 'de' ? 'de_DE' : lang === 'es' ? 'es_ES' : 'en_US'} />
		<meta property="og:site_name" content="holtsdav" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{canonicalURL && <meta property="og:url" content={canonicalURL} />}
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{robots && <meta name="robots" content={robots} />}
		{canonicalURL && <link rel="canonical" href={canonicalURL} />}
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/png" href={holtsdavLogo.src} />
		<title>{title}</title>
	</head>
	<body>
		<a class="skip-link" href="#main-content">Skip to content</a>
		<div class="site-shell">
			<Header />
			<main id="main-content">
				<slot />
			</main>
			<Footer />
		</div>
	</body>
</html>
