---
import {Image,getImage} from 'astro:assets';
import {projects} from '../data/portfolio';
const items=await Promise.all(projects.map(async p=>({id:p.id,name:p.name,icon:(await getImage({src:p.icon,width:112,height:112,format:p.icon.format==='svg'?'svg':'webp'})).src})));
---
<nav class="workspace-dock" aria-label="Workspace">
 <a class="dock-home dock-item" href="/" aria-label="Home"><svg class="dock-art home-art" viewBox="0 0 64 64" aria-hidden="true"><path d="M10 28 32 9l22 19v27H10Z" fill="#fbfcfd" stroke="#c7ccd4" stroke-width="1.5"/><path d="m5 30 27-23 27 23" fill="none" stroke="#6f88a7" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/><path d="M26 54V35h13v19" fill="#a6bdd6"/><rect x="15" y="33" width="7" height="8" rx="1" fill="#d8e3ed"/></svg><span>Home</span><i aria-hidden="true"></i></a>
 <div class="dock-opened" data-opened-projects aria-label="Opened projects"></div>
 <span class="dock-divider" aria-hidden="true" data-dock-divider hidden></span>
 <a class="dock-projects dock-item" href="/projects/" data-open-projects aria-haspopup="dialog" aria-controls="projects-folder" aria-expanded="false"><svg class="dock-art folder-art" viewBox="0 0 68 64" aria-hidden="true"><path d="M7 15a5 5 0 0 1 5-5h17l6 7h22a5 5 0 0 1 5 5v31H7Z" fill="#4881b6"/><rect x="10" y="21" width="47" height="28" rx="2" fill="#e9f5ff"/><path d="M6 26h56l-4 28a5 5 0 0 1-5 4H12a5 5 0 0 1-5-4Z" fill="#9fc9eb"/><path d="M8 28h52" stroke="#d2eaff" stroke-width="2"/></svg><span>Projects</span><i aria-hidden="true"></i></a>
 <button class="dock-more dock-item" type="button" popovertarget="workspace-more" aria-label="More: About, Support, Privacy and Impressum"><svg class="dock-art more-art" viewBox="0 0 64 64" aria-hidden="true"><rect x="6" y="9" width="52" height="47" rx="14" fill="#f7f8fa" stroke="#cfd5dd"/><g fill="#6c798c"><circle cx="20" cy="33" r="3"/><circle cx="32" cy="33" r="3"/><circle cx="44" cy="33" r="3"/></g></svg><span>More</span></button>
</nav>
<dialog class="projects-folder" id="projects-folder" aria-labelledby="folder-title"><div class="folder-bar"><button class="window-close" type="button" data-close-folder aria-label="Close Projects"><span aria-hidden="true">×</span></button><h2 id="folder-title">Projects</h2><span>{projects.length} items</span></div><div class="folder-grid">{projects.map(p=><a class="folder-project" href={`/projects/${p.id}/`} data-folder-project={p.id}><Image src={p.icon} alt="" width={100} height={100} loading="eager" format={p.icon.format==='svg'?'svg':'webp'}/><span>{p.name}</span></a>)}</div></dialog>
<div id="workspace-more" class="workspace-more" popover><a href="/about/">About <span aria-hidden="true">↗</span></a><a href="/support/">Support <span aria-hidden="true">↗</span></a><hr/><a href="/privacy/">Privacy</a><a href="/impressum/">Impressum</a></div>

<script type="application/json" id="workspace-project-data" set:html={JSON.stringify(items).replaceAll('<','\\u003c')}/>
<script>import '../scripts/workspace';</script>
