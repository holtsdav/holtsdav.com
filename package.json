{
  "name": "holtsdav.com",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "check": "tsc --noEmit && npm run contact:types && tsc -p workers/contact/tsconfig.json",
    "test:contact": "node --test workers/contact/contact.test.mjs",
    "contact:types": "wrangler types --config workers/contact/wrangler.jsonc workers/contact/worker-configuration.d.ts --env-interface ContactEnv",
    "contact:dev": "wrangler dev --config workers/contact/wrangler.jsonc",
    "contact:deploy": "wrangler deploy --config workers/contact/wrangler.jsonc",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.3",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/three": "^0.185.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.129.0"
  }
}
