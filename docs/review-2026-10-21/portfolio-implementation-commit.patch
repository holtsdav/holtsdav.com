+/* Light desktop. Real project art; no third-party reference assets. */
+/* Own the active light palette independently of copied owner-only legacy edits. */
+:root{--color-page:#f8f8f6;--color-elevated:#fff;--color-primary:#18181b;--color-secondary:#52525b;--color-accent:#2563eb}
+.workspace-site::selection,.workspace-site ::selection{background:rgba(37,99,235,.16);color:#0f172a}
+.workspace-site .legal-content{background:#fff;border:1px solid rgba(0,0,0,.07);box-shadow:0 4px 20px -4px rgba(0,0,0,.03)}
+.workspace-site .legal-content a{text-decoration-color:rgba(37,99,235,.4)}
+.workspace-site .language-switcher a{border-color:rgba(0,0,0,.1);background:#fff}
+.workspace-site .language-switcher a:hover{border-color:rgba(0,0,0,.2)}
+.workspace-site .language-switcher a[aria-current=page]{border-color:rgba(37,99,235,.4);background:rgba(37,99,235,.08);color:var(--color-accent)}
+:root{color-scheme:light;--ws-bg:#f7f8fa;--ws-ink:#273140;--ws-muted:#667080;--ws-line:#dce1e8;--ws-blue:#426690;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;font-synthesis:none}
