+	root.dataset.particleReady = 'true';
+	requestRender();
+
+	return () => {
+		destroyed = true;
+		delete root.dataset.particleReady;
+		canvas.hidden = true;
+		if (animationFrame) window.cancelAnimationFrame(animationFrame);
