+<particle-wordmark class="particle-wordmark">
+	<h1 id="hero-title" aria-label="holtsdav – David Holtschke">
+		<span class="holts-segment">holts</span><span class="dav-segment">dav</span>
+	</h1>
+	<canvas aria-hidden="true" hidden></canvas>
+</particle-wordmark>
+
+<script src="../scripts/original-wordmark-dark-reference.ts"></script>
+
+<style>
+	.particle-wordmark {
+		position: relative;
+		display: block;
+		width: clamp(320px, 78vw, 1050px);
+		max-width: 100%;
+		height: clamp(220px, 22vw, 290px);
+		margin-inline: auto;
+		overflow: hidden;
+	}
+
+	h1,
+	canvas {
+		position: absolute;
+		inset: 0;
+	}
+
+	h1 {
+		display: flex;
+		align-items: center;
+		justify-content: center;
+		opacity: 0;
+		white-space: nowrap;
+	}
+
+	.holts-segment {
+		color: #e4ebff;
+	}
+
+	.dav-segment {
+		color: #8197ff;
+	}
+
+	canvas {
+		display: block;
+		width: 100%;
+		height: 100%;
+		background: transparent;
+		opacity: 0;
+		touch-action: none;
+		transition: opacity 320ms ease;
+	}
+
+	canvas[hidden] {
+		display: none;
+	}
+
+	.particle-wordmark[data-particle-ready="true"] canvas {
+		opacity: 1;
+	}
+
+	@media (max-width: 760px) {
+		.particle-wordmark {
+			width: 100%;
+			height: clamp(250px, 68vw, 290px);
+		}
+	}
+
+	@media (min-width: 761px) and (max-height: 800px) {
+		.particle-wordmark {
+			width: min(72vw, 920px);
+			height: 220px;
+		}
+	}
+
+	@media (prefers-reduced-motion: reduce) {
+		h1 {
+			opacity: 1 !important;
+		}
+
+		canvas {
+			display: none;
+		}
+	}
+</style>
diff --git a/src/components/DraftDocument.astro b/src/components/DraftDocument.astro
new file mode 100644
index 0000000..a23b426
--- /dev/null
+++ b/src/components/DraftDocument.astro
@@ -0,0 +1,26 @@
+---
+import BaseLayout from '../layouts/BaseLayout.astro';
+import '../styles/document-draft.css';
+interface Props {
+  title: string;
+  description: string;
+  kind: string;
+  contents: { id: string; label: string }[];
+}
+const { title, description, kind, contents } = Astro.props;
+---
+<BaseLayout title={`${title} — Review draft | holtsdav`} description={description} robots="noindex, nofollow">
+  <article class="draft-document">
+    <div class="draft-breadcrumb"><a href="/">← Portfolio</a><span>NotiLog / {kind}</span></div>
+    <aside class="draft-notice" aria-labelledby="draft-status">
+      <strong id="draft-status">Local draft · Not published</strong>
+      <p>Prepared for David’s review on 20 October 2026. This is not a release announcement or an approved privacy policy. Confirm the final app build and the marked review points before using this content publicly.</p>
+    </aside>
+    <header class="draft-heading"><p class="draft-kicker">NOTILOG / {kind.toUpperCase()}</p><h1>{title}</h1><p>{description}</p></header>
+    <div class="draft-columns">
+      <nav class="draft-contents" aria-label="On this page"><p>On this page</p>{contents.map(item => <a href={`#${item.id}`}>{item.label}</a>)}</nav>
+      <div class="draft-copy"><slot /></div>
+    </div>
+    <footer class="draft-end"><p>Review draft only. Nothing has been published or configured in the app.</p><a href="#main-content">Back to top ↑</a></footer>
+  </article>
+</BaseLayout>
