+  .folio h1 { font-size: 41px; }
+  .folio-hero .folio-eyebrow { font-size: 7px; }
+  .folio-object-stage { transform: scale(.8); margin-block: 10px 0; }
+  .folio-dock a { width: 64px; }
+  .folio-filters button { padding-inline: 13px; }
+  .folio-contact h2 { font-size: 55px; }
+  .folio-email { font-size: 21px; }
+}
+@media (prefers-reduced-motion: reduce) {
+  .folio *, .folio *::before,.folio *::after,.folio-dock * { animation: none !important; transition: none !important; scroll-behavior: auto !important; }
+  .folio-app-object:hover,.folio-button:hover,.folio-project-media:hover img,.folio-dock a:hover svg { transform: none; }
+}
+@media print {
+  .folio-dock,.folio-filter-bar,.folio-copy-email,.skip-link { display: none !important; }
+  .folio-shell { width: 100%; }
+  .folio-project { break-inside: avoid; }
+  .portfolio-page .site-footer { padding-bottom: 0; }
+}
+/* Still screenshots keep product content readable and respect reduced motion. */
+.folio-glass-phones { display: flex; align-items: center; justify-content: center; gap: 22px; padding-block: 35px; }
+.folio-glass-phones img { display: block; width: 45%; max-width: 180px; height: auto; border: 4px solid #26252c; border-radius: 24px; box-shadow: 0 16px 25px -10px #5e547b50; }
+.folio-glass-phones img:last-child { width: 40%; max-width: 160px; transform: translateY(22px); }
+@media (max-width: 800px) { .folio-glass-phones { gap: 12px; } .folio-glass-phones img { border-width: 3px; border-radius: 18px; } }
+@media (max-width: 620px) { .folio-glass-phones { padding-block: 25px 35px; gap: 18px; } .folio-glass-phones img { width: 44%; max-width: 150px; } .folio-glass-phones img:last-child { width: 40%; max-width: 135px; } .folio-contact-star { font-size: 38px; top: -22px; right: 8px; } }
+
+/* The fixed dock must never cover the browser's keyboard scroll destination. */
+html:has(.folio-dock) { scroll-padding-bottom: calc(112px + env(safe-area-inset-bottom, 0px)); }
+.folio :where(a, button) { scroll-margin-block: 16px; }
+.folio-hero > * { min-width: 0; }
+/* Stack the hero before either narrow grid track can crop the app objects. */
+@media (min-width: 621px) and (max-width: 900px) {
+  .folio-hero { grid-template-columns: minmax(0,1fr); min-height: 0; padding-top: 65px; }
+  .folio-hero-copy { max-width: 660px; }
+  .folio h1 { font-size: clamp(57px,8.5vw,75px); }
+  .folio-hero .folio-eyebrow { font-size: 10px; }
+  .folio-intro { max-width: 440px; font-size: 17px; }
+  .folio-object-stage { width: 360px; max-width: 100%; height: 390px; transform: none; justify-self: center; margin: 45px 0 20px; }
+  .folio-hero-foot { width: 100%; padding-top: 22px; grid-column: 1 / -1; }
+}
