diff --git a/scripts/verify-notilog-drafts.mjs b/scripts/verify-notilog-drafts.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..17e325df5db3dc86d355a81ef6d3001c12377a37
--- /dev/null
+++ b/scripts/verify-notilog-drafts.mjs
@@ -0,0 +1,77 @@
+import assert from 'node:assert/strict';
+import { mkdir,writeFile } from 'node:fs/promises';
+import path from 'node:path';
+const {chromium}=await import(process.env.PLAYWRIGHT_MODULE||'playwright');
+const base=process.env.PORTFOLIO_PREVIEW_URL||'http://127.0.0.1:4326';
+assert.ok(['127.0.0.1','localhost'].includes(new URL(base).hostname));
+const out=path.resolve('docs/review-2026-10-20');await mkdir(path.join(out,'screenshots'),{recursive:true});
+const browser=await chromium.launch({headless:true,...(process.env.PORTFOLIO_CHROMIUM_PATH?{executablePath:process.env.PORTFOLIO_CHROMIUM_PATH}:{})});
+const context=await browser.newContext({viewport:{width:1440,height:1000},reducedMotion:'reduce'});
+await context.route('**/*',route=>['localhost','127.0.0.1'].includes(new URL(route.request().url()).hostname)?route.continue():route.abort());
+const page=await context.newPage(),errors=[],results=[];page.on('pageerror',e=>errors.push(e.message));
+async function check(name,fn){await fn();results.push({name,passed:true});console.log('PASS '+name)}
+async function visit(route){const r=await page.goto(base+route,{waitUntil:'networkidle'});assert.equal(r.status(),200,route)}
+try{
+  for(const [route,name] of [['/support/notilog/','notilog-support'],['/drafts/notilog-privacy/','notilog-privacy-draft']]){
+    await check(name+': draft markers, semantics, privacy and links',async()=>{
+      await visit(route);
+      assert.equal(await page.locator('h1').count(),1);assert.equal(await page.locator('main').count(),1);
+      assert.equal(await page.locator('html').getAttribute('lang'),'en');
+      assert.equal(await page.locator('meta[name="robots"]').getAttribute('content'),'noindex, nofollow');
+      assert.equal(await page.locator('link[rel="canonical"]').count(),0);
+      assert.equal(await page.getByText('Local draft · Not published',{exact:true}).count(),1);
+      assert.equal(await page.locator('[aria-labelledby]').evaluateAll(els=>els.filter(el=>el.getAttribute('aria-labelledby').split(/\s+/).some(id=>!document.getElementById(id))).length),0);
+      const content=await page.locator('.draft-document').textContent();assert.ok(!content.includes('/Users/'));assert.ok(!content.includes('TURNSTILE_SECRET'));
+      const ids=await page.locator('[id]').evaluateAll(els=>els.map(el=>el.id));assert.equal(new Set(ids).size,ids.length);
+      for(const href of await page.locator('.draft-document a').evaluateAll(els=>els.map(el=>el.getAttribute('href')))){
+        assert.ok(href);
+        if(href.startsWith('#'))assert.equal(await page.locator(`[id="${href.slice(1)}"]`).count(),1,href);
+        else if(href.startsWith('/'))assert.equal((await context.request.get(base+href)).status(),200,href);
+        else if(href.startsWith('mailto:'))assert.ok(href.startsWith('mailto:contact@holtsdav.com?'));
+        else assert.equal(new URL(href).protocol,'https:');
+      }
+      assert.equal(await page.locator('.draft-document a[target="_blank"]:not([rel~="noreferrer"])').count(),0);
+    });
+    await check(name+': responsive text bounds at 320, 390, 621, 768, 1024 and 1440 px',async()=>{
+      for(const width of [320,390,621,768,1024,1440]){
+        await page.setViewportSize({width,height:1000});
+        const outside=await page.locator('.draft-document h1,.draft-document h2,.draft-document a,.draft-notice,.draft-review-point').evaluateAll(els=>els.filter(el=>{const r=el.getBoundingClientRect();return r.left< -1||r.right>innerWidth+1}).map(el=>el.textContent.slice(0,60)));
+        assert.deepEqual(outside,[],`${width}: ${JSON.stringify(outside)}`);
+      }
+    });
+    await check(name+': text contrast',async()=>{
+      const failures=await page.evaluate(()=>{
+        const parse=v=>{const a=v.match(/[\d.]+/g)?.map(Number)??[0,0,0,1];return [...a.slice(0,3),a[3]??1]};
+        const over=(a,b)=>[...a.slice(0,3).map((v,i)=>v*a[3]+b[i]*(1-a[3])),1];
+        const lum=c=>c.slice(0,3).map(v=>{v/=255;return v<=.04045?v/12.92:((v+.055)/1.055)**2.4}).reduce((s,v,i)=>s+v*[.2126,.7152,.0722][i],0);
+        const walker=document.createTreeWalker(document.querySelector('.draft-document'),NodeFilter.SHOW_TEXT),bad=[];
+        for(let n=walker.nextNode();n;n=walker.nextNode()){
+          const el=n.parentElement;if(!n.textContent.trim()||!el.getClientRects().length)continue;
+          const s=getComputedStyle(el);if(s.visibility!=='visible')continue;
+          const ancestors=[];for(let p=el;p;p=p.parentElement)ancestors.unshift(p);
+          let bg=[255,255,255,1];for(const p of ancestors)bg=over(parse(getComputedStyle(p).backgroundColor),bg);
+          const a=lum(over(parse(s.color),bg)),b=lum(bg),ratio=(Math.max(a,b)+.05)/(Math.min(a,b)+.05),size=parseFloat(s.fontSize),min=size>=24||(size>=18.66&&Number(s.fontWeight)>=700)?3:4.5;
+          if(ratio<min-.01)bad.push({text:n.textContent.trim().slice(0,50),ratio});
+        }return bad;
+      });assert.deepEqual(failures,[]);
+    });
+    await check(name+': keyboard, anchor clearance, no-JavaScript content and screenshots',async()=>{
+      await page.setViewportSize({width:390,height:844});await visit(route);
+      await page.keyboard.press('Tab');assert.equal(await page.evaluate(()=>document.activeElement.textContent),'Skip to content');
+      await page.keyboard.press('Enter');assert.equal(await page.evaluate(()=>document.activeElement.id),'main-content');
+      await page.locator('.draft-contents a[href="#retention"]').focus();
+      assert.notEqual(await page.locator('.draft-contents a[href="#retention"]').evaluate(el=>getComputedStyle(el).outlineStyle),'none');
+      await page.keyboard.press('Enter');
+      assert.equal(new URL(page.url()).hash,'#retention');
+      const top=await page.locator('#retention h2').evaluate(el=>el.getBoundingClientRect().top);assert.ok(top>=100,`Anchor heading covered: ${top}`);
+      assert.equal(await page.evaluate(()=>getComputedStyle(document.documentElement).scrollBehavior),'auto');
+      for(const [width,height,view] of [[1440,1000,'desktop'],[390,844,'mobile']]){
+        await page.setViewportSize({width,height});await visit(route);await page.mouse.move(0,0);
+        await page.screenshot({path:path.join(out,'screenshots',`${view}-${name}.png`),fullPage:true});
+      }
+      const nojs=await browser.newContext({javaScriptEnabled:false,viewport:{width:390,height:844}}),p=await nojs.newPage();
+      await p.goto(base+route);assert.ok(await p.locator('.draft-copy section').count()>=7);assert.equal(await p.locator('h1').count(),1);await nojs.close();
+    });
+  }
+  await check('No JavaScript exceptions',async()=>assert.deepEqual(errors,[]));
+}finally{await writeFile(path.join(out,'notilog-draft-qa.json'),JSON.stringify({base,date:new Date().toISOString(),results,errors},null,2)+'\n');await browser.close()}
diff --git a/src/components/DraftDocument.astro b/src/components/DraftDocument.astro
new file mode 100644
index 0000000000000000000000000000000000000000..a23b426b392a84786b60d0c5a0fbb2017b8f28be
--- /dev/null
+++ b/src/components/DraftDocument.astro
@@ -0,0 +1,26 @@
+---
+import BaseLayout from '../layouts/BaseLayout.astro';
+import '../styles/document-draft.css';
+interface Props {
+  title: string;
+  description: string;
+  kind: string;
+  contents: { id: string; label: string }[];
+}
+const { title, description, kind, contents } = Astro.props;
+---
+<BaseLayout title={`${title} — Review draft | holtsdav`} description={description} robots="noindex, nofollow">
+  <article class="draft-document">
+    <div class="draft-breadcrumb"><a href="/">← Portfolio</a><span>NotiLog / {kind}</span></div>
+    <aside class="draft-notice" aria-labelledby="draft-status">
+      <strong id="draft-status">Local draft · Not published</strong>
+      <p>Prepared for David’s review on 20 October 2026. This is not a release announcement or an approved privacy policy. Confirm the final app build and the marked review points before using this content publicly.</p>
+    </aside>
+    <header class="draft-heading"><p class="draft-kicker">NOTILOG / {kind.toUpperCase()}</p><h1>{title}</h1><p>{description}</p></header>
+    <div class="draft-columns">
+      <nav class="draft-contents" aria-label="On this page"><p>On this page</p>{contents.map(item => <a href={`#${item.id}`}>{item.label}</a>)}</nav>
+      <div class="draft-copy"><slot /></div>
+    </div>
+    <footer class="draft-end"><p>Review draft only. Nothing has been published or configured in the app.</p><a href="#main-content">Back to top ↑</a></footer>
+  </article>
+</BaseLayout>
diff --git a/src/pages/drafts/notilog-privacy.astro b/src/pages/drafts/notilog-privacy.astro
new file mode 100644
index 0000000000000000000000000000000000000000..77dcbdc8a55e697315bb05197cba6db726a58310
--- /dev/null
+++ b/src/pages/drafts/notilog-privacy.astro
@@ -0,0 +1,23 @@
+---
+import DraftDocument from '../../components/DraftDocument.astro';
+const contents = [
+  { id: 'scope', label: 'Scope of this draft' },
+  { id: 'local-data', label: 'Data on your device' },
+  { id: 'capture-permissions', label: 'Capture and permissions' },
+  { id: 'network', label: 'Apple services and network use' },
+  { id: 'retention', label: 'Retention and deletion' },
+  { id: 'backups', label: 'Backups and sync' },
+  { id: 'support', label: 'Support contact' },
+  { id: 'owner-review', label: 'David’s review points' },
+];
+---
+<DraftDocument title="NotiLog privacy policy draft" description="A technical, source-backed draft about local notification storage, Apple metadata requests, manual backups and App Lock. David’s approval and release verification are pending." kind="Privacy draft" contents={contents}>
+  <section id="scope" aria-labelledby="scope-title"><h2 id="scope-title">Scope of this draft</h2><p>This draft describes the NotiLog app source reviewed on 20 October 2026. It is prepared for David Holtschke’s review and is <strong>not an approved public policy or a legal compliance assurance</strong>.</p><p>The reviewed app has no NotiLog account, custom backend or built-in cloud sync. No advertising, analytics, purchase or third-party crash-reporting SDK integration was found in the reviewed project configuration. Source review alone does not establish the behavior of a future release, App Store settings or an email provider.</p></section>
+  <section id="local-data" aria-labelledby="data-title"><h2 id="data-title">Data on your device</h2><p>NotiLog stores notification information passed to it by your configured automations: title, subtitle and message text; source-app name and identifier; capture dates, repeated-capture records and time-sensitive status; and your pin choices. Settings and cached app metadata/artwork are also stored locally.</p><p>The archive uses local SwiftData storage with CloudKit disabled in the reviewed configuration. Notification content is not sent to a developer-operated server by the reviewed capture, storage or backup code.</p><p>Notification content can contain personal or sensitive information. Choose which source apps to capture and protect access to your device. This draft does not claim that all local data or manual backups are separately encrypted by NotiLog.</p></section>
+  <section id="capture-permissions" aria-labelledby="permission-title"><h2 id="permission-title">Capture and permissions</h2><p>You choose source apps and enable their notification automations in Apple Shortcuts. Those automations pass the notification fields to NotiLog’s Archive Notification action. Disable or remove an automation in Shortcuts to stop its future captures; existing archived data remains until deleted.</p><p>The app cannot reconstruct notifications from before capture was configured. What is archived depends on what the configured automation passes to the app.</p><h3>Optional App Lock</h3><p>App Lock asks the system to authenticate with Face ID, Touch ID or the device passcode. NotiLog receives an authentication result, not your biometric template or passcode. App Lock protects the interface; it does not encrypt manual backup files or disable the capture automation.</p><aside class="draft-review-point"><p><strong>David’s review:</strong> Confirm all permission prompts, shortcut behavior and authentication paths against the shipping build and hardware. Do not describe the App Lock setting as a guarantee that capture or exported files are blocked.</p></aside></section>
+  <section id="network" aria-labelledby="network-title"><h2 id="network-title">Apple services and network use</h2><h3>App metadata and icons</h3><p>To show source-app names, icons and App Store links, the reviewed app requests public metadata from Apple’s App Store lookup service. The request includes a source app’s bundle identifier and a storefront country code, with fallback lookups where needed. <strong>These requests reveal the queried app identifier and storefront to Apple.</strong> Notification titles, subtitles and message text are not included in the lookup request.</p><p>The app downloads artwork from the URL returned by Apple and caches it locally. This network activity is separate from storing the notification archive. Apple’s handling of its service requests is described in <a href="https://www.apple.com/legal/privacy/" target="_blank" rel="noreferrer">Apple’s privacy information</a>.</p><h3>Setup and links</h3><p>Opening the shared shortcut during setup uses Apple’s iCloud Shortcuts service. Opening an App Store link or support email uses the selected system app or service. These user-directed actions are not a built-in cloud sync for the notification archive.</p><aside class="draft-review-point"><p><strong>David’s review:</strong> Recheck the final app’s network dependencies and any Apple diagnostics, App Store metrics or external support tools used outside the app code. Do not infer “no network requests” or a final App Store privacy label from the absence of an analytics SDK.</p></aside></section>
+  <section id="retention" aria-labelledby="retention-title"><h2 id="retention-title">Retention and deletion</h2><p>The reviewed main app offers 7 Days, 30 Days, 90 Days and Forever. Finite cleanup removes unpinned notifications older than the selected period, based on each notification’s latest capture date. Pinned notifications are kept by retention cleanup; Forever has no age cutoff.</p><p>Cleanup runs during app activity and capture processing, so this draft does not promise deletion at an exact background deadline. Settings previews eligible removals before applying a shorter period when records would be deleted, with an option to export first. Manual deletion of a notification removes all its repeated captures; Delete All History removes archived notifications and source-app records after confirmation.</p><p>Deleted records cannot be recovered by changing retention back to a longer period. An earlier backup would be needed, if available.</p><aside class="draft-review-point"><p><strong>David’s review:</strong> The separate retention safety fix preserves existing Forever/finite choices and treats unreadable preferences conservatively. Verify its integration into the actual release before describing upgrade behavior as shipped. This draft does not claim that the proposed fix can recover past deletions.</p></aside></section>
+  <section id="backups" aria-labelledby="backups-title"><h2 id="backups-title">Manual backups and sync</h2><p>Exported backups contain readable notification content, source-app information and backup metadata such as app/schema version and export date. The reviewed exporter writes JSON data and does not encrypt the exported file.</p><p>You choose a destination in Files. Saving to iCloud Drive or another cloud provider sends the file to that provider under its own terms and privacy practices. App Lock does not protect a copy after export. Delete exported copies separately when you no longer want them.</p><p>NotiLog does not provide built-in cloud sync in the reviewed source. Device-level backups may include local app data depending on your system and provider settings; confirm those settings separately.</p></section>
+  <section id="support" aria-labelledby="support-title"><h2 id="support-title">Support contact</h2><p>The proposed NotiLog contact is <a href="mailto:contact@holtsdav.com?subject=NotiLog%20privacy%20question">contact@holtsdav.com</a>. If you choose to email, the address, message and any attachments you send leave the local app and are handled through the email services involved. Please use synthetic examples and do not send your notification archive or private message content.</p><aside class="draft-review-point"><p><strong>David’s review:</strong> Confirm the operator identity, contact address, email provider, support-message retention and request-handling process before this becomes a public policy. These details cannot be established from the app source.</p></aside><div class="draft-related"><a href="/support/notilog/">Open the local support draft →</a></div></section>
+  <section id="owner-review" aria-labelledby="owner-title"><h2 id="owner-title">David’s publication review</h2><ol><li>Identify the exact build to release and confirm that this draft matches it, including retention migration, permissions, capture behavior and network dependencies.</li><li>Confirm the operator/contact and any support-provider, diagnostics or other data handling outside the app. Complete the policy’s applicable contact and request-handling details.</li><li>Choose and approve the final support and privacy URLs. This draft is separate from the existing policy route; no URL has been published or set in the app by this work.</li><li>Reconcile the app’s privacy manifest, native policy and App Store privacy answers with the final build. Consult <a href="https://developer.apple.com/help/app-store-connect/manage-app-information/manage-app-privacy/" target="_blank" rel="noreferrer">Apple’s current App Privacy guidance</a> as part of that review.</li><li>Resolve the marked uncertainties and review the complete policy before removing this draft status or publishing.</li></ol></section>
+</DraftDocument>
diff --git a/src/pages/support/notilog.astro b/src/pages/support/notilog.astro
new file mode 100644
index 0000000000000000000000000000000000000000..0dd8d00bc0239e29404be9edb8e820c535570403
--- /dev/null
+++ b/src/pages/support/notilog.astro
@@ -0,0 +1,21 @@
+---
+import DraftDocument from '../../components/DraftDocument.astro';
+const contents = [
+  { id: 'how-it-works', label: 'How capture works' },
+  { id: 'connect-capture', label: 'Connect capture' },
+  { id: 'troubleshoot', label: 'Nothing arrives' },
+  { id: 'retention', label: 'Retention and deletion' },
+  { id: 'backups', label: 'Backups and App Lock' },
+  { id: 'contact', label: 'Get help' },
+  { id: 'review', label: 'Release review points' },
+];
+---
+<DraftDocument title="NotiLog support" description="Setup, capture limits, retention and backups for the reviewed iPhone and iPad app source. Public release details are still for David to confirm." kind="Support draft" contents={contents}>
+  <section id="how-it-works" aria-labelledby="how-title"><h2 id="how-title">How capture works</h2><p>NotiLog keeps a searchable local history of notifications passed to its <strong>Archive Notification</strong> action by Apple Shortcuts. The reviewed source targets iOS and iPadOS 27 or later and does not require a NotiLog account.</p><p>You choose the source apps in Shortcuts. Capture depends on those automations being configured and running. NotiLog cannot retrieve notifications from before setup or recover earlier items from Notification Center. An imported backup is not evidence that live capture is working.</p></section>
+  <section id="connect-capture" aria-labelledby="setup-title"><h2 id="setup-title">Connect capture</h2><ol><li>Use <strong>Set Up Shortcut</strong> in NotiLog to open the <a href="https://www.icloud.com/shortcuts/150326e49cfb495dbd292fc1c7ab2f07" target="_blank" rel="noreferrer">existing shared NotiLog shortcut</a>. Select the source app and add it to Shortcuts.</li><li>Open the installed shortcut. If its actions are hidden, open the editor’s list view. Expand the notification trigger and enable <strong>Automation</strong>.</li><li>Send a new notification from the selected source app. Return to NotiLog and check History and <strong>Last Captured</strong> in Settings.</li><li>For another source app, duplicate the shortcut in your Shortcuts library, give the copy a distinct name, select the other app, and enable that copy’s automation.</li></ol><p>To stop future capture, disable or remove the automation in Shortcuts. This does not delete notifications already archived in NotiLog.</p></section>
+  <section id="troubleshoot" aria-labelledby="trouble-title"><h2 id="trouble-title">Nothing arrives</h2><ul><li>Check that the correct source app is selected and the installed shortcut’s Automation switch is on.</li><li>Test with a <strong>new</strong> notification. Previous notifications are not backfilled.</li><li>If the NotiLog shortcut was renamed or removed, reinstall it through setup. When reinstalling the shared shortcut, replace the existing copy as the setup guide instructs.</li><li>A waiting setup state means setup was marked finished; a recorded capture means one arrived previously. Neither state guarantees that the automation continues running.</li></ul><p>If the problem persists, note the setup step, device and OS version before contacting support. Avoid repeatedly changing retention or deleting history while investigating a capture problem.</p><aside class="draft-review-point"><p><strong>David’s release review:</strong> Verify the setup labels and repeat capture on the final app and supported OS versions. Locked, terminated, rebooted-device and additional-app capture still need the hardware acceptance checks in the app’s release checklist.</p></aside></section>
+  <section id="retention" aria-labelledby="retention-title"><h2 id="retention-title">Retention and deletion</h2><p>The reviewed main source offers <strong>7 Days, 30 Days, 90 Days and Forever</strong>. Finite retention uses a notification’s latest capture date. Pinned notifications are excluded from retention cleanup; Forever has no automatic age cutoff.</p><p>When a new selection would remove archived notifications, Settings previews the removal and offers Cancel, Export Backup First, or Apply. If nothing is eligible for removal, the choice can apply without that deletion confirmation. Export first if you may need the older history.</p><p>Deleting one notification removes its repeated captures across days. <strong>Delete All History</strong> removes the archive and source-app records after confirmation. These actions cannot be undone inside the app; recovery needs an earlier backup, if you have one.</p><aside class="draft-review-point"><p><strong>David’s release review:</strong> Match this text to the actual release build. A separately reviewed safety fix preserves Forever and existing retention choices during upgrades and handles unreadable preferences conservatively. It is not established as released, and cannot restore previously deleted notifications.</p></aside></section>
+  <section id="backups" aria-labelledby="backup-title"><h2 id="backup-title">Backups and App Lock</h2><h3>Export and import</h3><p>Settings can export a manual backup and import one later. Imports merge with existing notifications rather than duplicating the same captures. A backup contains readable notification text and is <strong>not encrypted by NotiLog</strong>.</p><p>Choose the destination in Files carefully. Saving to iCloud Drive or another provider sends that backup to the provider; this is separate from app sync. NotiLog has no built-in cloud sync in the reviewed source.</p><h3>Optional App Lock</h3><p>App Lock uses the device’s Face ID, Touch ID or passcode authentication. It protects the interface, not exported backup files, and does not switch off your Shortcuts automations. If authentication is unavailable, check that a device passcode is configured in system Settings.</p></section>
+  <section id="contact" aria-labelledby="contact-title"><h2 id="contact-title">Get help</h2><p>The proposed support contact is <a href="mailto:contact@holtsdav.com?subject=NotiLog%20support">contact@holtsdav.com</a>. David still needs to confirm it for NotiLog before publication.</p><p>Include the app version, device model, OS version, the step involved and whether the issue repeats. Use synthetic examples. <strong>Do not send your full archive or private notification text.</strong> Remove private details from screenshots before sharing them.</p><div class="draft-related"><a href="/drafts/notilog-privacy/">Read the separate privacy draft →</a><a href="/">Return to the portfolio</a></div></section>
+  <section id="review" aria-labelledby="review-title"><h2 id="review-title">Before this guide is published</h2><ul><li>Confirm the exact release build, supported OS versions and the integration of the reviewed retention safety fix.</li><li>Confirm the support mailbox and the final public support/privacy URLs. The app’s public URL configuration is still unset; this local page does not configure it.</li><li>Complete the real-device capture and App Lock acceptance checks. This guide does not promise that every notification will be captured.</li></ul></section>
+</DraftDocument>
diff --git a/src/styles/document-draft.css b/src/styles/document-draft.css
new file mode 100644
index 0000000000000000000000000000000000000000..4427adf494a97afe8218641988f4b5cb81510b72
--- /dev/null
+++ b/src/styles/document-draft.css
@@ -0,0 +1,43 @@
+.draft-document { width: min(1120px,calc(100% - 80px)); margin: 0 auto; padding: 70px 0 65px; color: #25272b; }
+.draft-document :where(h1,h2,h3,p) { margin: 0; }
+.draft-breadcrumb { display: flex; justify-content: space-between; gap: 20px; align-items: center; margin-bottom: 25px; font-size: 13px; color: #555d68; }
+.draft-breadcrumb a { min-height: 44px; display: inline-flex; align-items: center; font-weight: 600; }
+.draft-notice { padding: 22px 25px; border: 1px solid #b8c8e5; border-radius: 12px; background: #edf3ff; color: #273c64; }
+.draft-notice strong { display: block; font-size: 15px; }
+.draft-notice p { max-width: 860px; font-size: 14px; line-height: 1.75; margin-top: 6px; }
+.draft-heading { padding: 48px 0 45px; border-bottom: 1px solid #d9dde3; }
+.draft-kicker { font: 11px/1.5 'SFMono-Regular',Consolas,monospace; letter-spacing: .08em; color: #4f6179; }
+.draft-heading h1 { font-size: clamp(35px,4.5vw,60px); line-height: 1.1; letter-spacing: -.045em; font-weight: 600; margin-top: 17px; max-width: 850px; }
+.draft-heading > p:last-child { font-size: 17px; line-height: 1.75; max-width: 760px; margin-top: 24px; color: #555d68; }
+.draft-columns { display: grid; grid-template-columns: 220px minmax(0,1fr); gap: 60px; padding-top: 40px; }
+.draft-contents { align-self: start; position: sticky; top: 120px; }
+.draft-contents > p { font-size: 12px; font-weight: 700; margin-bottom: 12px; color: #555d68; }
+.draft-contents a { display: flex; align-items: center; min-height: 44px; padding: 8px 0; font-size: 13px; color: #345278; border-bottom: 1px solid #e1e4e9; }
+.draft-contents a:hover { color: #1747b5; text-decoration: underline; text-underline-offset: 4px; }
+.draft-copy section { padding: 0 0 36px; margin-bottom: 34px; border-bottom: 1px solid #dfe3e8; scroll-margin-top: 120px; }
+.draft-copy section:last-child { border: 0; margin-bottom: 0; }
+.draft-copy h2 { font-size: 27px; line-height: 1.25; letter-spacing: -.025em; font-weight: 600; margin-bottom: 18px; }
+.draft-copy h3 { font-size: 19px; line-height: 1.4; letter-spacing: -.01em; font-weight: 600; margin: 28px 0 12px; }
+.draft-copy p,.draft-copy li { font-size: 16px; line-height: 1.8; color: #444c57; }
+.draft-copy p + p { margin-top: 16px; }
+.draft-copy ul,.draft-copy ol { margin: 18px 0; padding-left: 24px; }
+.draft-copy li { padding-left: 4px; margin-block: 9px; }
+.draft-copy a { color: #1747b5; text-decoration: underline; text-underline-offset: 4px; overflow-wrap: anywhere; }
+.draft-copy strong { color: #25272b; font-weight: 650; }
+.draft-review-point { margin-top: 22px; padding: 17px 20px; background: #f3efe5; border-left: 3px solid #9c6e25; border-radius: 0 7px 7px 0; }
+.draft-review-point p { font-size: 14px; color: #5d4826; line-height: 1.75; }
+.draft-review-point strong { color: #513b1a; }
+.draft-related { display: flex; gap: 20px; align-items: center; flex-wrap: wrap; margin-top: 22px; }
+.draft-related a { display: inline-flex; align-items: center; min-height: 44px; font-size: 14px; }
+.draft-end { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding-top: 30px; border-top: 1px solid #d9dde3; }
+.draft-end p { font-size: 12px; color: #555d68; }
+.draft-end a { display: inline-flex; align-items: center; min-height: 44px; font-size: 12px; font-weight: 600; white-space: nowrap; }
+@media(max-width:850px) { .draft-columns { grid-template-columns: 180px minmax(0,1fr); gap: 32px; } }
+@media(max-width:700px) { .draft-document { width: calc(100% - 40px); padding-top: 45px; } .draft-breadcrumb { font-size: 11px; gap: 10px; } .draft-notice { padding: 18px; } .draft-heading { padding-block: 36px; } .draft-heading > p:last-child { font-size: 16px; } .draft-columns { grid-template-columns: minmax(0,1fr); gap: 35px; padding-top: 30px; } .draft-contents { position: static; display: grid; grid-template-columns: 1fr 1fr; gap: 0 24px; } .draft-contents > p { grid-column: 1/-1; } .draft-copy h2 { font-size: 25px; } .draft-copy p,.draft-copy li { font-size: 15px; } .draft-end { align-items: start; flex-direction: column; gap: 6px; } }
+@media(prefers-reduced-motion:reduce) { .draft-document * { scroll-behavior: auto !important; transition: none !important; } }
+@media print { .draft-contents { display: none; } .draft-columns { display: block; } .draft-document { width: 100%; } .draft-notice { break-inside: avoid; } }
+html:has(.draft-document) { scroll-padding-top: 112px; }
+.draft-copy section[id] { scroll-margin-top: 24px; }
+.draft-document a { scroll-margin-block: 24px; }
+.draft-copy ol { list-style: decimal; }
+.draft-copy ul { list-style: disc; }
