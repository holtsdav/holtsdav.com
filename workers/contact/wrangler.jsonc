{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "holtsdav-contact",
  "main": "index.ts",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "holtsdav.com/api/contact*",
      "zone_name": "holtsdav.com"
    },
    {
      "pattern": "www.holtsdav.com/api/contact*",
      "zone_name": "holtsdav.com"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://holtsdav.com,https://www.holtsdav.com",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAErhKY3UFv7LcXz4"
  },
  "secrets": {
    "required": [
      "TURNSTILE_SECRET"
    ]
  },
  "send_email": [
    {
      "name": "CONTACT_EMAIL",
      "destination_address": "contact@holtsdav.com",
      "remote": true
    }
  ],
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
